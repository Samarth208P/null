# One private root .env: pnpm setup:sepolia creates it without printing secrets.
# Only VITE_ values are public browser configuration. Never prefix a secret with VITE_.

# Sepolia deployment and local protocol context.
NULL_CHAIN_ID=11155111
NULL_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NULL_ASSET_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NULL_DEPLOYER_PRIVATE_KEY=
NULL_MAX_FEE_GWEI=10
NULL_MAX_DEPLOYMENT_ETH=0.05
NULL_POOL_ADDRESS=
# All relative manifest paths resolve from the repository root.
NULL_MANIFEST_PATH=deployments/11155111.json
# Separate private signer for the free local treasury authorization CLI.
NULL_TREASURY_SIGNER_PRIVATE_KEY=
NULL_TREASURY_POLICY_METADATA=
NULL_TREASURY_REGISTRATION_BLINDER=

# Public browser values: optional integrations remain blank until configured.
VITE_DEFAULT_ENVIRONMENT=sandbox
VITE_PRIVY_APP_ID=
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_GRAPH_URL=
VITE_RELAYER_URL=
VITE_POOL_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
VITE_CONFIRMATIONS=3
VITE_ORGANIZATION_URL=
VITE_DEPLOYMENT_MANIFEST_URL=/deployment.json
VITE_ARTIFACT_BASE_URL=

# Optional local relayer: a separate gas wallet, never a recipient or signer key.
RELAYER_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RELAYER_PRIVATE_KEY=
RELAYER_PORT=8787
RELAYER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BROADCAST_PRIVATE_KEY=

# Optional Privy organization service. Local wallet signing needs no Privy account.
ORGANIZATION_PORT=8788
ORGANIZATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_ORGANIZATION_MEMBER_IDS=
PRIVY_ORGANIZATION_WALLET_ID=
PRIVY_ORGANIZATION_WALLET_ADDRESS=
PRIVY_ORGANIZATION_OWNER_QUORUM_ID=
PRIVY_ORGANIZATION_ENTITY_ID=
PRIVY_ORGANIZATION_POLICY_IDS=
PRIVY_ORGANIZATION_MINIMUM_APPROVALS=1
