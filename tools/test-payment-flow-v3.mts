 await assert.rejects(()=>client.submit(withdrawal,{mode:'wallet',wallet}));await assert.rejects(()=>rpc.simulateContract({address:nullPool,abi:poolArtifact.abi,functionName:'withdraw',args:[withdrawal.publicOperation.proof,withdrawal.publicOperation.publicInputs]}));pass('double withdrawal rejected by client and contract');
 const treasury=(await client.recoverTreasuryNotes(checkpoints)).filter(x=>!x.spent&&x.note.amountAtomic>0n);assert.equal(treasury.length,1);
 await assert.rejects(()=>client.prepareWithdrawal({note:treasury[0].note,recipient:account.address,acknowledgePublicWithdrawal:true}));pass('treasury exit cannot bypass organization approval');
 const refund=await client.prepareWithdrawal({note:treasury[0].note,recipient:account.address,authPolicy:policy,authorize,acknowledgePublicWithdrawal:true,...progress});await client.submit(refund,{mode:'wallet',wallet},progress);assert.equal(await balance(account.address),400_000n);assert.equal(await balance(nullPool),0n);pass('approved treasury refund and zero remaining pool liabilities');
 assert.equal(await balance(account.address)+await balance(receiver),1_000_000n);evidence.buildIntegrity=JSON.parse(await readFile('contracts/artifacts/build-integrity.json','utf8')).sources;evidence.circuitArtifacts=compiledManifest.circuits;evidence.completed=true;pass('full conservation: 1 USDC deposited = 0.6 received + 0.4 refunded');
 for(const tx of evidence.transactions as {hash?:`0x${string}`;action?:string;gasUsed?:string}[]){if(tx.hash && tx.action!=='deploy')tx.gasUsed=(await rpc.getTransactionReceipt({hash:tx.hash})).gasUsed.toString();}
} catch(error) { console.error('FAIL local payment flow:',error instanceof Error?error.name:'unknown');evidence.failure=error instanceof Error?error.message.split('\n')[0].slice(0,200):'unknown';process.exitCode=1;
